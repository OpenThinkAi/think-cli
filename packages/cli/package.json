{
  "name": "@openthink/think",
  "version": "3.0.0-rc.1",
  "type": "module",
  "description": "Local-first memory for AI agents — resident daemon, vector recall, an L1 outbox, git-shareable cortex. Bundles `think serve`.",
  "bin": {
    "think": "dist/index.js"
  },
  "files": [
    "dist",
    "views"
  ],
  "scripts": {
    "build": "tsup && find dist -name '*.js' -exec perl -i -pe 's/from \"sqlite\"/from \"node:sqlite\"/g' {} +",
    "prepublishOnly": "npm run build",
    "prepack": "npm run gen:npm-readme",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:hub": "tsx scripts/e2e-byo-hub.ts",
    "gen:commands": "tsx scripts/gen-command-table.ts",
    "gen:npm-readme": "tsx scripts/gen-npm-readme.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "homepage": "https://openthink.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenThinkAi/think-cli.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "memory",
    "ai",
    "agents",
    "work-log",
    "local-first",
    "daemon",
    "vector",
    "recall"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "@anthropic-ai/sdk": "^0.115.0",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "hono": "^4.12.15",
    "sqlite-vec": "0.1.9",
    "undici": "^7.29.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
